DB_NAME=Calendar
DB_USER=sa
DB_PASSWORD=YourDatabasePasswordHere
DB_HOST=database_ip
DB_PORT=1186
DB_DIALECT=mssql
PORT=3000

# Storage config: 'local' or 's3'
STORAGE_TYPE=local
MAX_FILE_SIZE_MB=50
# AWS S3 config (required if STORAGE_TYPE=s3)
BUCKET_NAME=your_s3_bucket_name
BUCKET_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# CDN / upload config
# If you want upload URLs to point to a CDN service, set the base URL here.
# Example: http://localhost:4040/uploads
CDN_UPLOAD_URL=http://localhost:4040/uploads
# Optional custom upload directory inside the backend container
# UPLOADS_DIR=/usr/src/app/uploads

# Email config
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM=your_email@gmail.com

# JWT congig
JWT_SECRET=abcde
JWT_REFRESH_SECRET=abcde
 
FRONTEND_URL= http://localhost
 
VITE_API_URL=http://localhost:3000/api

VITE_API_URL=http://localhost:3000/api

